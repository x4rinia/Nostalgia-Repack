+bool ChatHandler::HandleXXpCommand(char* args)
+{
+    if (!args || !*args)
+    {
+        SendSysMessage("=== Nostalgia XP-System ===");
+        SendSysMessage("---------------------------");
+        SendSysMessage(".x xp 1 - Blizzlike (x1)");
+        SendSysMessage(".x xp 2 - Entspannt (x3)");
+        SendSysMessage(".x xp 3 - Erhoeht (x5)");
+        SendSysMessage(".x xp 4 - Schnell (x10)");
+        SendSysMessage(".x xp 5 - Twink (x20)");
+        return true;
+    }
+
+    switch (atoi(args))
+    {
+    case 1:
+        return HandleModifyXpRateCommand((char*)"1");
+
+    case 2:
+        return HandleModifyXpRateCommand((char*)"3");
+
+    case 3:
+        return HandleModifyXpRateCommand((char*)"5");
+
+    case 4:
+        return HandleModifyXpRateCommand((char*)"10");
+
+    case 5:
+        return HandleModifyXpRateCommand((char*)"20");
+
+    default:
+        SendSysMessage("Ungueltige Auswahl.");
+        SendSysMessage(".x xp 1 - Blizzlike (x1)");
+        SendSysMessage(".x xp 2 - Entspannt (x3)");
+        SendSysMessage(".x xp 3 - Erhoeht (x5)");
+        SendSysMessage(".x xp 4 - Schnell (x10)");
+        SendSysMessage(".x xp 5 - Twink (x20)");
+        return false;
+    }
+}
