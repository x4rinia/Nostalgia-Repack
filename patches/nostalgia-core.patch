+bool ChatHandler::HandleOutdoorRivalDebugCommand(char* args)
+{
+    bool enabled = !sPlayerBotMgr.IsOutdoorRivalDebug();
+    if (char* option = ExtractArg(&args))
+    {
+        if (strcmp(option, "on") == 0)
+            enabled = true;
+        else if (strcmp(option, "off") == 0)
+            enabled = false;
+        else
+        {
+            SendSysMessage("Benutzung: .rival debug [on|off]");
+            SetSentErrorMessage(true);
+            return false;
+        }
+    }
+
+    sPlayerBotMgr.SetOutdoorRivalDebug(enabled);
+    PSendSysMessage("Rival-Debug ist jetzt %s. Der Status wird in diesem Chat und in der Serverkonsole angezeigt.", enabled ? "AN" : "AUS");
+    return true;
+}
+
+bool ChatHandler::HandleOutdoorRivalStatusCommand(char* /*args*/)
+{
+    PSendSysMessage("Rivalen aktiv: %u/%u | normale Gebiete: %u%% | feindliche Gebiete: %u%% | Pruefung alle %u Sekunden | Debug: %s",
+        sPlayerBotMgr.GetOutdoorRivalCount(), sPlayerBotMgr.GetOutdoorRivalMaxActive(), sPlayerBotMgr.GetOutdoorRivalChance(),
+        sPlayerBotMgr.GetOutdoorRivalEnemyChance(), sPlayerBotMgr.GetOutdoorRivalCheckSeconds(),
+        sPlayerBotMgr.IsOutdoorRivalDebug() ? "AN" : "AUS");
+    SendSysMessage("Befehle: .rival debug [on|off] | .rival status | .rival test");
+    return true;
+}
+
+bool ChatHandler::HandleOutdoorRivalTestCommand(char* args)
+{
+    if (char* option = ExtractArg(&args))
+    {
+        if (strcmp(option, "cancel") == 0)
+        {
+            sPlayerBotMgr.CancelRivalTest();
+            SendSysMessage("Rivalen-Test abgebrochen.");
+            return true;
+        }
+
+        SendSysMessage("Benutzung: .rival test [cancel]");
+        SetSentErrorMessage(true);
+        return false;
+    }
+
+    Player* player = GetSession() ? GetSession()->GetPlayer() : nullptr;
+    if (!player || !sPlayerBotMgr.StartRivalTest(player))
+    {
+        SendSysMessage("Ein Rivalen-Test laeuft bereits oder dein Charakter ist nicht in der Welt.");
+        SetSentErrorMessage(true);
+        return false;
+    }
+
+    PSendSysMessage("Rivalen-Test gestartet. In 10 Sekunden erscheinen %s.",
+        player->GetMapId() == 0 && player->GetDistance2d(-13261.0f, 167.0f) <= 70.0f ? "drei Arena-Rivalen" : "ein Open-World-Rivale");
+    return true;
+}
