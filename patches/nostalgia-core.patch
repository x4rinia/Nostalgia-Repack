+    // Arena rivals are permanent now. The timed chest has no influence on
+    // their lifecycle and can disappear normally after being looted.
+}
+
+bool PlayerBotMgr::HasGurubashiArenaChest() const
+{
+    static uint32 const GURUBASHI_ARENA_CHEST = 179697;
+
+    bool hasLoadedArenaRival = false;
+    for (auto const& itr : m_bots)
+    {
+        BattleBotAI const* battleBot = dynamic_cast<BattleBotAI const*>(itr.second->ai.get());
+        if (!battleBot || !battleBot->IsGurubashiArenaRival() || !battleBot->me || !battleBot->me->IsInWorld())
+            continue;
+
+        hasLoadedArenaRival = true;
+        GameObject* chest = battleBot->me->FindNearestGameObject(GURUBASHI_ARENA_CHEST, 100.0f);
+        if (chest && chest->isSpawned() && chest->getLootState() == GO_READY)
+            return true;
+    }
+
+    // During the initial bot-login pass no arena bot has a world object yet.
+    // Defer the chest test until one is available instead of removing fresh bots early.
+    return !hasLoadedArenaRival;
+}
+
+void PlayerBotMgr::UpdateGurubashiArenaRivals()
+{
+    if (m_gurubashiArenaTestExpiry && sWorld.GetGameTime() < m_gurubashiArenaTestExpiry)
+    {
+        EngageGurubashiArenaPlayers();
+        return;
+    }
+
+    uint32 arenaRivalCount = 0;
+    for (auto const& itr : m_bots)
+        if (BattleBotAI const* battleBot = dynamic_cast<BattleBotAI const*>(itr.second->ai.get()))
+            if (battleBot->IsGurubashiArenaRival() && !itr.second->requestRemoval)
+                ++arenaRivalCount;
+
+    if (m_confGurubashiArenaRivalsEnable)
+    {
+        time_t const now = sWorld.GetGameTime();
+        if (!m_gurubashiArenaRivalTargetCount)
+            m_gurubashiArenaRivalTargetCount = urand(2, 4);
+
+        // A fresh, random cast of rivals takes over every hour.  Deletion and
+        // re-login are deliberately split over manager updates to stay safe.
+        if (m_gurubashiArenaNextRotation && now >= m_gurubashiArenaNextRotation)
+        {
+            DeleteGurubashiArenaRivals();
+            m_gurubashiArenaRivalTargetCount = urand(2, 4);
+            m_gurubashiArenaNextRotation = now + HOUR;
+            sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Nostalgia] Gurubashi Arena: rivals rotate now.");
+            return;
+        }
+
+        if (arenaRivalCount < m_gurubashiArenaRivalTargetCount)
+            AddGurubashiArenaRivals(m_gurubashiArenaRivalTargetCount - arenaRivalCount);
+
+        if (!m_gurubashiArenaNextRotation)
+            m_gurubashiArenaNextRotation = now + HOUR;
+        EngageGurubashiArenaPlayers();
+    }
+    else if (arenaRivalCount)
+    {
+        DeleteGurubashiArenaRivals();
+    }
+}
+
+void PlayerBotMgr::EngageGurubashiArenaPlayers()
+{
+    Player* target = nullptr;
+    for (auto const& itr : sWorld.GetAllSessions())
+    {
+        WorldSession* session = itr.second;
+        Player* player = session ? session->GetPlayer() : nullptr;
+        if (player && !player->IsBot() && player->IsAlive() && IsInGurubashiArena(player))
+        {
+            target = player;
+            break;
+        }
+    }
+
+    if (!target)
+        return;
+
+    target->SetFFAPvP(true);
+    for (auto const& itr : m_bots)
+    {
+        BattleBotAI* battleBot = dynamic_cast<BattleBotAI*>(itr.second->ai.get());
+        if (!battleBot || !battleBot->IsGurubashiArenaRival())
+            continue;
+
+        battleBot->SetGurubashiArenaTarget(target->GetObjectGuid());
+        if (battleBot->me && battleBot->me->IsInWorld() && battleBot->me->IsAlive())
+        {
+            battleBot->me->SetFFAPvP(true);
+            battleBot->AttackStart(target);
+        }
+    }
+}
