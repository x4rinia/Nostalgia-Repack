+bool PlayerBotMgr::AddAmbientPartyBot(Player* leader, uint8 race, uint8 class_, std::string const& name)
+{
+    if (!leader || name.empty() || !sObjectMgr.GetPlayerInfo(race, class_))
+        return false;
+
+    // Never steal the name of a real or already active temporary player.
+    if (sObjectMgr.GetPlayerGuidByName(name))
+        return false;
+
+    if (leader->IsTaxiFlying() || leader->InBattleGround())
+        return false;
+
+    Group* group = leader->GetGroup();
+    if (group && group->isBGGroup())
+        group = leader->GetOriginalGroup();
+
+    if (group)
+    {
+        if (!group->IsLeader(leader->GetObjectGuid()) && !group->IsAssistant(leader->GetObjectGuid()))
+            return false;
+
+        if (group->IsFull() || sWorld.getConfig(CONFIG_UINT32_PARTY_BOT_MAX_BOTS) &&
+            (group->GetMembersCount() - 1 >= sWorld.getConfig(CONFIG_UINT32_PARTY_BOT_MAX_BOTS)))
+            return false;
+    }
+
+    if (Map const* map = leader->GetMap())
+    {
+        if (map->IsDungeon() && map->GetPlayers().getSize() >= map->GetMapEntry()->maxPlayers)
+            return false;
+    }
+
+    float x, y, z;
+    leader->GetNearPoint(leader, x, y, z, 0, 5.0f, frand(0.0f, 6.0f));
+    PartyBotAI* ai = new PartyBotAI(leader, nullptr, ROLE_INVALID, race, class_, leader->GetLevel(),
+        leader->GetMapId(), leader->GetMap()->GetInstanceId(), x, y, z, leader->GetOrientation());
+
+    if (AddBot(ai, name))
+        return true;
+
+    delete ai;
+    return false;
+}
