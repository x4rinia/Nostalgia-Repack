+void BattleBotAI::CleanupOutdoorRival()
+{
+    if (!m_outdoorRival || !m_outdoorTargetPvpApplied)
+        return;
+
+    if (Player* target = ObjectAccessor::FindPlayer(m_outdoorTargetGuid))
+        if (!m_outdoorTargetHadPvp)
+            target->UpdatePvP(false, true);
+
+    m_outdoorTargetPvpApplied = false;
+}
+
+void BattleBotAI::EndOutdoorRival()
+{
+    CleanupOutdoorRival();
+    me->AttackStop();
+    me->StopMoving();
+    botEntry->requestRemoval = true;
+}
+
+void BattleBotAI::UpdateOutdoorRivalAI(uint32 /*diff*/)
+{
+    if (m_outdoorRivalRemainingMs <= BB_UPDATE_INTERVAL)
+    {
+        EndOutdoorRival();
+        return;
+    }
+    m_outdoorRivalRemainingMs -= BB_UPDATE_INTERVAL;
+
+    if (me->IsDead())
+    {
+        if (!m_wasDead)
+        {
+            m_wasDead = true;
+            OnJustDied();
+        }
+        EndOutdoorRival();
+        return;
+    }
+
+    Player* target = ObjectAccessor::FindPlayer(m_outdoorTargetGuid);
+    if (!target || !target->IsAlive() || target->GetMap() != me->GetMap() || target->GetDistance(me) > 100.0f)
+    {
+        EndOutdoorRival();
+        return;
+    }
+
+    // The encounter temporarily enables PvP only for this bot and its intended target.
+    // It is removed again as soon as the encounter ends, so normal open-PvP stays off.
+    if (!m_outdoorTargetPvpApplied)
+    {
+        m_outdoorTargetHadPvp = target->IsPvP();
+        if (!m_outdoorTargetHadPvp)
+            target->UpdatePvP(true, true);
+        m_outdoorTargetPvpApplied = true;
+    }
+    me->UpdatePvP(true, true);
+
+    if (me->HasUnitState(UNIT_STATE_CAN_NOT_REACT_OR_LOST_CONTROL))
+    {
+        BreakCrowdControlEffects();
+        return;
+    }
+
+    if (me->GetCurrentSpell(CURRENT_AUTOREPEAT_SPELL))
+    {
+        if (!me->GetVictim())
+            me->InterruptSpell(CURRENT_AUTOREPEAT_SPELL, true);
+        else if (me->GetClass() == CLASS_HUNTER)
+        {
+            if (me->GetCombatDistance(me->GetVictim()) < 8.0f)
+                me->InterruptSpell(CURRENT_AUTOREPEAT_SPELL, true);
+            else
+                UpdateInCombatAI_Hunter();
+        }
+        return;
+    }
+
+    if (me->IsNonMeleeSpellCasted(false, false, true))
+        return;
+
+    if (me->GetStandState() != UNIT_STAND_STATE_STAND)
+        me->SetStandState(UNIT_STAND_STATE_STAND);
+    if (me->GetSheath() == SHEATH_STATE_UNARMED && !me->IsMounted())
+        me->SetSheath(SHEATH_STATE_MELEE);
+
+    Unit* victim = me->GetVictim();
+    if (victim != target || !IsValidHostileTarget(target))
+    {
+        if (victim)
+            me->AttackStop();
+        AttackStart(target);
+        return;
+    }
+
+    if (!me->HasInArc(target, 2 * M_PI_F / 3) && !me->IsMoving())
+    {
+        me->SetInFront(target);
+        me->SendMovementPacket(MSG_MOVE_SET_FACING, false);
+    }
+
+    if (!me->HasUnitState(UNIT_STATE_MELEE_ATTACKING) && m_role != ROLE_HEALER)
+    {
+        AttackStart(target);
+        return;
+    }
+
+    if (me->IsInCombat())
+        UpdateInCombatAI();
+}
+
+void BattleBotAI::UpdateGurubashiArenaRivalAI()
+{
+    // The arena itself is a free-for-all PvP area. Keeping the flag on makes these
+    // bots valid opponents for every player in the ring without enabling open PvP elsewhere.
+    me->SetFFAPvP(true);
+
+    if (me->IsDead())
+    {
+        if (!m_wasDead)
+        {
+            m_wasDead = true;
+            OnJustDied();
+        }
+        return;
+    }
+
+    if (me->HasUnitState(UNIT_STATE_CAN_NOT_REACT_OR_LOST_CONTROL))
+    {
+        BreakCrowdControlEffects();
+        return;
+    }
+
+    // Arena rivals are local event opponents. They never follow anyone out of
+    // the ring and never select another automated player as an opponent.
+    if (!IsInsideGurubashiArena(me))
+    {
+        me->AttackStop(true);
+        me->CombatStop(true);
+        ReturnToGurubashiArena();
+        return;
+    }
+
+    Unit* victim = me->GetVictim();
+    if (victim && !IsGurubashiArenaPlayer(victim))
+    {
+        me->AttackStop(true);
+        me->CombatStop(true);
+        ReturnToGurubashiArena();
+        return;
+    }
+
+    if (!m_gurubashiArenaTargetGuid.IsEmpty())
+    {
+        if (Player* target = ObjectAccessor::FindPlayer(m_gurubashiArenaTargetGuid))
+        {
+            if (IsGurubashiArenaPlayer(target))
+            {
+                if (victim != target)
+                {
+                    // AttackStart() changes me->GetVictim().  Return immediately so the
+                    // stale value in "victim" below cannot make this rival retreat in
+                    // the very same AI update.
+                    if (AttackStart(target))
+                        return;
+                }
+            }
+            else
+                m_gurubashiArenaTargetGuid.Clear();
+        }
+        else
+            m_gurubashiArenaTargetGuid.Clear();
+    }
+
+    if (me->GetCurrentSpell(CURRENT_AUTOREPEAT_SPELL))
+    {
+        if (!me->GetVictim())
+            me->InterruptSpell(CURRENT_AUTOREPEAT_SPELL, true);
+        else if (me->GetClass() == CLASS_HUNTER)
+        {
+            if (me->GetCombatDistance(me->GetVictim()) < 8.0f)
+                me->InterruptSpell(CURRENT_AUTOREPEAT_SPELL, true);
+            else
+                UpdateInCombatAI_Hunter();
+        }
+        return;
+    }
+
+    if (me->IsNonMeleeSpellCasted(false, false, true))
+        return;
+
+    if (me->GetStandState() != UNIT_STAND_STATE_STAND)
+        me->SetStandState(UNIT_STAND_STATE_STAND);
+    if (me->GetSheath() == SHEATH_STATE_UNARMED && !me->IsMounted())
+        me->SetSheath(SHEATH_STATE_MELEE);
+
+    if (!victim || !IsValidHostileTarget(victim) || !me->IsWithinDist(victim, VISIBILITY_DISTANCE_NORMAL))
+    {
+        if (victim)
+            me->AttackStop();
+        ReturnToGurubashiArena();
+        return;
+    }
+
+    if (!me->HasInArc(victim, 2 * M_PI_F / 3) && !me->IsMoving())
+    {
+        me->SetInFront(victim);
+        me->SendMovementPacket(MSG_MOVE_SET_FACING, false);
+    }
+
+    if (!me->HasUnitState(UNIT_STATE_MELEE_ATTACKING) && m_role != ROLE_HEALER)
+    {
+        AttackStart(victim);
+        return;
+    }
+
+    if (me->IsInCombat())
+        UpdateInCombatAI();
+}
+
+bool BattleBotAI::IsInsideGurubashiArena(Unit const* unit) const
+{
+    static float const ARENA_CENTER_X = -13202.90f;
+    static float const ARENA_CENTER_Y = 276.76f;
+    static float const ARENA_RADIUS = 70.0f;
+
+    return unit && unit->GetMap() == me->GetMap() && unit->GetDistance2d(ARENA_CENTER_X, ARENA_CENTER_Y) <= ARENA_RADIUS;
+}
+
+bool BattleBotAI::IsGurubashiArenaPlayer(Unit const* unit) const
+{
+    if (!unit || unit->GetTypeId() != TYPEID_PLAYER || !IsInsideGurubashiArena(unit))
+        return false;
+
+    Player const* player = static_cast<Player const*>(unit);
+    return !player->IsBot();
+}
+
+void BattleBotAI::ReturnToGurubashiArena()
+{
+    if (me->GetDistance2d(m_x, m_y) <= 5.0f)
+    {
+        me->StopMoving();
+        return;
+    }
+
+    me->GetMotionMaster()->Clear();
+    me->GetMotionMaster()->MovePoint(0, m_x, m_y, m_z, MOVE_PATHFINDING | MOVE_EXCLUDE_STEEP_SLOPES);
+}
