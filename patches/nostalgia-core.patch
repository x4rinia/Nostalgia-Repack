diff --git a/src/game/NostalgiaAmbientChat.cpp b/src/game/NostalgiaAmbientChat.cpp
new file mode 100644
index 000000000..da7521833
--- /dev/null
+++ b/src/game/NostalgiaAmbientChat.cpp
@@ -0,0 +1,226 @@
+#include "NostalgiaAmbientChat.h"
+
+#include "Chat.h"
+#include "ChannelMgr.h"
+#include "Config/Config.h"
+#include "Database/DatabaseEnv.h"
+#include "Log.h"
+#include "Policies/SingletonImp.h"
+#include "PlayerBotMgr.h"
+#include "Server/Packets/Query.h"
+#include "SharedDefines.h"
+#include "Utilities/Random.h"
+#include "World.h"
+#include "WorldSession.h"
+
+#include <algorithm>
+
+INSTANTIATE_SINGLETON_1(NostalgiaAmbientChat);
+
+namespace
+{
+bool IsAllianceRace(uint8 race)
+{
+    return race == RACE_HUMAN || race == RACE_DWARF || race == RACE_NIGHTELF || race == RACE_GNOME;
+}
+
+bool IsVisibleToTeam(NostalgiaAmbientChatEntry const& entry, uint32 viewerTeam)
+{
+    if (viewerTeam == ALLIANCE)
+        return IsAllianceRace(entry.race);
+    if (viewerTeam == HORDE)
+        return !IsAllianceRace(entry.race);
+
+    return false;
+}
+
+uint32 GetWhoZoneId(NostalgiaAmbientChatEntry const& entry)
+{
+    // The chat itself is global, but the Who list should feel like a populated world.
+    static uint32 const allianceZones[] = {
+        12, 40, 10, 44, 38, 11, 267, 45, 33, 440, 46, 28, 139, 1519, 1537, 1657,
+        36, 717, 721, 796, 1337, 1176, 1584, 1583, 2057, 2017, 2717, 2677, 3456
+    };
+    static uint32 const hordeZones[] = {
+        14, 17, 215, 85, 130, 406, 331, 400, 405, 357, 8, 3, 51, 1637, 1638, 1497,
+        2437, 718, 209, 719, 491, 722, 1337, 1176, 2100, 1477, 1584, 1583, 2057, 2017, 2717, 2677, 3456
+    };
+
+    uint32 const* zones = IsAllianceRace(entry.race) ? allianceZones : hordeZones;
+    uint32 const count = IsAllianceRace(entry.race) ? uint32(sizeof(allianceZones) / sizeof(uint32)) : uint32(sizeof(hordeZones) / sizeof(uint32));
+    return zones[entry.senderGuid % count];
+}
+}
+
+void NostalgiaAmbientChat::Load()
+{
+    m_entries.clear();
+
+    std::unique_ptr<QueryResult> result = WorldDatabase.Query(
+        "SELECT zone_id, channel_name, sender_guid, sender_name, race, gender, class, level, guild_name, message "
+        "FROM nostalgia_ambient_chat WHERE enabled = 1");
+
+    if (!result)
+    {
+        sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, ">> Loaded 0 Nostalgia ambient chat messages");
+        return;
+    }
+
+    do
+    {
+        Field* fields = result->Fetch();
+        NostalgiaAmbientChatEntry entry;
+        entry.zoneId = fields[0].GetUInt32();
+        entry.channelName = fields[1].GetCppString();
+        entry.senderGuid = fields[2].GetUInt32();
+        entry.senderName = fields[3].GetCppString();
+        entry.race = fields[4].GetUInt8();
+        entry.gender = fields[5].GetUInt8();
+        entry.classId = fields[6].GetUInt8();
+        entry.level = fields[7].GetUInt8();
+        entry.guildName = fields[8].GetCppString();
+        entry.message = fields[9].GetCppString();
+        m_entries.push_back(std::move(entry));
+    }
+    while (result->NextRow());
+
+    sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, ">> Loaded %u Nostalgia ambient chat messages", uint32(m_entries.size()));
+}
+
+bool NostalgiaAmbientChat::SendFakeNameQueryResponse(WorldSession* session, ObjectGuid guid) const
+{
+    if (!session || guid.GetHigh() != HIGHGUID_PLAYER)
+        return false;
+
+    auto const entry = std::find_if(m_entries.begin(), m_entries.end(), [guid](NostalgiaAmbientChatEntry const& candidate)
+    {
+        return candidate.senderGuid == guid.GetCounter();
+    });
+
+    if (entry == m_entries.end())
+        return false;
+
+    auto response = std::make_unique<WorldPackets::Query::NameQueryResponse>();
+    response->playerGuid = guid;
+    response->name = entry->senderName;
+    response->race = entry->race;
+    response->gender = entry->gender;
+    response->class_ = entry->classId;
+    session->SendPacket(std::move(response));
+    return true;
+}
+
+bool NostalgiaAmbientChat::SendFakeWhisperResponse(WorldSession* session, std::string const& targetName) const
+{
+    if (!session)
+        return false;
+
+    auto const entry = std::find_if(m_entries.begin(), m_entries.end(), [&targetName](NostalgiaAmbientChatEntry const& candidate)
+    {
+        return candidate.senderName == targetName;
+    });
+
+    if (entry == m_entries.end())
+        return false;
+
+    ObjectGuid const senderGuid(HIGHGUID_PLAYER, entry->senderGuid);
+    SendFakeNameQueryResponse(session, senderGuid);
+
+    char const* const greetings[] = {
+        "hi", "hallo", "huhu", "hey", "hey was geht", "na", "na du", "moin",
+        "jo", "jojo", "yo", "jep", "hiii :)", "hallo hallo", "sag an", "was los?",
+        "bin da", "hier", "hehe", "xD", "sec", "bin kurz afk", "was brauchst?",
+        "alles klar bei dir?", "grüße", "nabend", "tach", "bitte?", "joo", "^^"
+    };
+    WorldPacket response;
+    ChatHandler::BuildChatPacket(response, CHAT_MSG_WHISPER, greetings[urand(0, 29)], LANG_UNIVERSAL,
+        CHAT_TAG_NONE, senderGuid, entry->senderName.c_str());
+    session->SendPacket(&response);
+    return true;
+}
+
+bool NostalgiaAmbientChat::TryHandleFakeGroupInvite(WorldSession* session, std::string const& targetName) const
+{
+    if (!sConfig.GetBoolDefault("Nostalgia.AmbientChat.InviteBots", true))
+        return false;
+
+    auto const entry = std::find_if(m_entries.begin(), m_entries.end(), [&targetName](NostalgiaAmbientChatEntry const& candidate)
+    {
+        return candidate.senderName == targetName;
+    });
+
+    if (entry == m_entries.end())
+        return false;
+
+    if (!session || !session->GetPlayer())
+        return true;
+
+    if (sPlayerBotMgr.AddAmbientPartyBot(session->GetPlayer(), entry->race, entry->classId, entry->senderName))
+        session->SendNotification("%s schliesst sich deiner Gruppe an.", entry->senderName.c_str());
+    else
+        session->SendNotification("%s kann deiner Gruppe gerade nicht beitreten.", entry->senderName.c_str());
+
+    return true;
+}
+
+uint32 NostalgiaAmbientChat::AppendWhoEntries(WorldPacket& data, uint32 currentCount, uint32 maximumCount, uint32 viewerTeam) const
+{
+    uint32 const perFactionMaximum = std::min<uint32>(50, uint32(std::max(1, sConfig.GetIntDefault("Nostalgia.AmbientChat.WhoPerFaction", 50))));
+    uint32 added = 0;
+
+    for (NostalgiaAmbientChatEntry const& entry : m_entries)
+    {
+        if (currentCount >= maximumCount || added >= perFactionMaximum)
+            break;
+
+        if (!IsVisibleToTeam(entry, viewerTeam))
+            continue;
+
+        data << entry.senderName;
+        data << entry.guildName;
+        data << uint32(entry.level);
+        data << uint32(entry.classId);
+        data << uint32(entry.race);
+        data << GetWhoZoneId(entry);
+        ++currentCount;
+        ++added;
+    }
+
+    return currentCount;
+}
+
+uint32 NostalgiaAmbientChat::GetWhoEntryCount(uint32 viewerTeam) const
+{
+    uint32 const perFactionMaximum = std::min<uint32>(50, uint32(std::max(1, sConfig.GetIntDefault("Nostalgia.AmbientChat.WhoPerFaction", 50))));
+    uint32 count = 0;
+    for (NostalgiaAmbientChatEntry const& entry : m_entries)
+    {
+        if (!IsVisibleToTeam(entry, viewerTeam))
+            continue;
+
+        if (++count >= perFactionMaximum)
+            break;
+    }
+
+    return count;
+}
+
+void NostalgiaAmbientChat::Update(uint32 diff)
+{
+    if (!sConfig.GetBoolDefault("Nostalgia.AmbientChat.Enable", false) || m_entries.empty())
+        return;
+
+    if (m_nextMessageTimer > diff)
+    {
+        m_nextMessageTimer -= diff;
+        return;
+    }
+
+    NostalgiaAmbientChatEntry const& entry = m_entries[urand(0, uint32(m_entries.size() - 1))];
+    if (ChannelMgr* cMgr = channelMgr(ALLIANCE))
+        cMgr->SendExternalMessageToGeneralChannels(ObjectGuid(HIGHGUID_PLAYER, entry.senderGuid), entry.message.c_str());
+
+    int32 const minimum = std::max(10, sConfig.GetIntDefault("Nostalgia.AmbientChat.MinInterval", 25));
+    int32 const maximum = std::max(minimum, sConfig.GetIntDefault("Nostalgia.AmbientChat.MaxInterval", 55));
+    m_nextMessageTimer = urand(uint32(minimum), uint32(maximum)) * IN_MILLISECONDS;
+}
