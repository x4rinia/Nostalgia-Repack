+bool ChatHandler::HandleXMordeCommand(char* args)
+{
+    Player* player = m_session->GetPlayer();
+
+    uint32 dishonorableKills = player->GetUInt32Value(PLAYER_FIELD_LIFETIME_DISHONORBALE_KILLS);
+
+    // Keine ruchlosen Morde
+    if (dishonorableKills == 0)
+    {
+        PSendSysMessage("Du hast keine ruchlosen Morde.");
+        return true;
+    }
+
+    // Kosten berechnen (5 Gold pro RM)
+    uint32 cost = dishonorableKills * 5 * GOLD;
+
+    // ".x morde"
+    if (!args || !*args)
+    {
+        PSendSysMessage("RM: %u", dishonorableKills);
+        PSendSysMessage("Kosten: %ug", dishonorableKills * 5);
+        PSendSysMessage("Schreibe:");
+        PSendSysMessage(".x morde gold");
+        return true;
+    }
+
+ char* param = strtok(args, " ");
+
+    if (!param || strcmp(param, "gold") != 0)
+    {
+        PSendSysMessage("Benutze: .x morde gold");
+        return true;
+    }
+
+    // Genug Gold?
+    if (player->GetMoney() < cost)
+    {
+        PSendSysMessage("Du benötigst %u Gold.", dishonorableKills * 5);
+        return true;
+    }
+
+    // Gold abziehen
+    player->ModifyMoney(-int32(cost));
+
+
+    // RM aus der Datenbank entfernen
+    CharacterDatabase.PExecute("DELETE FROM `character_honor_cp` WHERE `guid` = %u AND `type` = %u", player->GetGUIDLow(), DISHONORABLE);
+
+    // Auch aus dem aktuellen HonorMgr entfernen
+    HonorMgr& hm = player->GetHonorMgr();
+
+    HonorCPMap& cp = hm.GetHonorCP();
+
+    for (auto it = cp.begin(); it != cp.end();)
+    {
+        if (it->type == DISHONORABLE)
+            it = cp.erase(it);
+        else
+            ++it;
+    }
+
+    hm.SetStoredDK(0);
+    hm.Update();
+    hm.SaveStoredData();
+
+    player->SaveToDB();
+
+
+    PSendSysMessage("RM nach Update: %u", player->GetUInt32Value(PLAYER_FIELD_LIFETIME_DISHONORBALE_KILLS));
+
+    PSendSysMessage("Du hast alle ruchlosen Morde gesühnt.");
+    PSendSysMessage("Gesühnte Morde: %u", dishonorableKills);
+    PSendSysMessage("Bezahlt: %u Gold", dishonorableKills * 5);
+
+    return true;
+}
