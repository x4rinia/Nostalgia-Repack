+bool ChatHandler::HandleXUseCommand(char* /*args*/)
+{
+    Player* pPlayer = GetSession()->GetPlayer();
+
+    if (!pPlayer)
+        return false;
+
+    std::list<GameObject*> objects;
+
+    MaNGOS::AllWorldObjectsInRange check(pPlayer, 10.0f);
+    MaNGOS::GameObjectListSearcher<MaNGOS::AllWorldObjectsInRange> searcher(objects, check);
+
+    Cell::VisitGridObjects(pPlayer, searcher, 10.0f);
+
+    if (objects.empty())
+    {
+        SendSysMessage("Keine Spielobjekte gefunden.");
+        return false;
+    }
+
+    // Nächstgelegenes Objekt suchen
+    GameObject* pGo = nullptr;
+    float bestDist = FLT_MAX;
+
+    for (GameObject* go : objects)
+    {
+        float dist = pPlayer->GetDistance(go);
+
+        if (dist < bestDist)
+        {
+            bestDist = dist;
+            pGo = go;
+        }
+    }
+
+    if (!pGo)
+    {
+        SendSysMessage("Kein Spielobjekt gefunden.");
+        return false;
+    }
+
+    PSendSysMessage("Benutze: %s (Entry: %u)", pGo->GetName(), pGo->GetEntry());
+
+    Group* pGroup = pPlayer->GetGroup();
+    if (!pGroup)
+    {
+        SendSysMessage("Du bist in keiner Gruppe.");
+        return false;
+    }
+
+    bool ok = false;
+
+    for (GroupReference* itr = pGroup->GetFirstMember(); itr; itr = itr->next())
+    {
+        Player* pMember = itr->getSource();
+
+        if (!pMember)
+            continue;
+
+        if (pMember == pPlayer)
+            continue;
+
+        // Hier kannst du später .x summon einbauen
+
+        ok = HandleXUseHelper(pMember, pGo) || ok;
+    }
+
+    if (ok)
+        SendSysMessage("Alle PartyBots haben das Objekt benutzt.");
+    else
+        SendSysMessage("Kein PartyBot konnte das Objekt benutzen.");
+
+    return ok;
+}
