+bool ChatHandler::HandleXSaveCommand(char* args)
+{
+    if (!args || !*args)
+    {
+        SendSysMessage("Benutzung: .x save <Dateiname>");
+        return false;
+    }
+
+    Player* player = m_session->GetPlayer();
+    if (!player)
+        return false;
+
+    player->SaveToDB();
+
+    std::string file = args;
+    file += ".pdump";
+
+    switch (PlayerDumpWriter().WriteDump(file.c_str(), player->GetGUIDLow()))
+    {
+    case DUMP_SUCCESS:
+        PSendSysMessage("Charakter '%s' wurde als '%s' gespeichert.", player->GetName(), file.c_str());
+        return true;
+
+    case DUMP_FILE_OPEN_ERROR:
+        PSendSysMessage(LANG_FILE_OPEN_FAIL, file.c_str());
+        SetSentErrorMessage(true);
+        return false;
+
+    default:
+        PSendSysMessage("Speichern fehlgeschlagen.");
+        SetSentErrorMessage(true);
+        return false;
+    }
+}
+
+bool ChatHandler::HandleXLoadCommand(char* args)
+{
+    if (!args || !*args)
+    {
+        SendSysMessage("Benutzung: .x load <Dateiname>");
+        return false;
+    }
+
+    Player* player = m_session->GetPlayer();
+    if (!player)
+        return false;
+
+    std::string file = args;
+    file += ".pdump";
+
+    std::string name = player->GetName();
+
+    uint32 accountId = m_session->GetAccountId();
+    uint32 lowguid = 0;
+
+    switch (PlayerDumpReader().LoadDump(file.c_str(), accountId, name, lowguid))
+    {
+    case DUMP_SUCCESS:
+        PSendSysMessage("Charakter '%s' wurde aus '%s' geladen.", name.c_str(), file.c_str());
+        return true;
+
+    case DUMP_FILE_OPEN_ERROR:
+        PSendSysMessage(LANG_FILE_OPEN_FAIL, file.c_str());
+        SetSentErrorMessage(true);
+        return false;
+
+    case DUMP_FILE_BROKEN:
+        PSendSysMessage(LANG_DUMP_BROKEN, file.c_str());
+        SetSentErrorMessage(true);
+        return false;
+
+    case DUMP_TOO_MANY_CHARS:
+        PSendSysMessage(LANG_ACCOUNT_CHARACTER_LIST_FULL);
+        SetSentErrorMessage(true);
+        return false;
+
+    default:
+        PSendSysMessage(LANG_COMMAND_IMPORT_FAILED);
+        SetSentErrorMessage(true);
+        return false;
+    }
+}
