+        PSendSysMessage(LANG_COMMAND_SPELL_BROKEN, 20773);
+        SetSentErrorMessage(true);
+        return false;
+    }
+
+    m_session->GetPlayer()->CastSpell(target, 20773, false);
+
+    return true;
+}
