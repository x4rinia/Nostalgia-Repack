+#ifndef NOSTALGIA_AMBIENT_CHAT_H
+#define NOSTALGIA_AMBIENT_CHAT_H
+
+#include "ObjectGuid.h"
+#include "Policies/Singleton.h"
+#include "Platform/Define.h"
+
+#include <string>
+#include <vector>
+
+class WorldSession;
+class WorldPacket;
+
+struct NostalgiaAmbientChatEntry
+{
+    uint32 zoneId;
+    uint32 senderGuid;
+    uint8 race;
+    uint8 gender;
+    uint8 classId;
+    uint8 level;
+    std::string channelName;
+    std::string guildName;
+    std::string senderName;
+    std::string message;
+};
+
+class NostalgiaAmbientChat
+{
+public:
+    void Load();
+    void Update(uint32 diff);
+    bool SendFakeNameQueryResponse(WorldSession* session, ObjectGuid guid) const;
+    bool SendFakeWhisperResponse(WorldSession* session, std::string const& targetName) const;
+    bool TryHandleFakeGroupInvite(WorldSession* session, std::string const& targetName) const;
+    uint32 AppendWhoEntries(WorldPacket& data, uint32 currentCount, uint32 maximumCount, uint32 viewerTeam) const;
+    uint32 GetWhoEntryCount(uint32 viewerTeam) const;
+    uint32 GetEntryCount() const { return uint32(m_entries.size()); }
+
+private:
+    std::vector<NostalgiaAmbientChatEntry> m_entries;
+    uint32 m_nextMessageTimer = 15000;
+};
+
+#define sNostalgiaAmbientChat MaNGOS::Singleton<NostalgiaAmbientChat>::Instance()
+
+#endif
