+void Player::LoadTransmogAppearances()
+{
+    m_transmogAppearances.clear();
+
+    std::unique_ptr<QueryResult> result = CharacterDatabase.PQuery("SELECT `item_guid`, `display_item_entry` FROM `character_transmog` WHERE `owner_guid` = '%u'", GetGUIDLow());
+    if (result)
+    {
+        do
+        {
+            Field* fields = result->Fetch();
+            uint32 itemGuid = fields[0].GetUInt32();
+            uint32 displayItemEntry = fields[1].GetUInt32();
+
+            if (sObjectMgr.GetItemPrototype(displayItemEntry))
+                m_transmogAppearances[itemGuid] = displayItemEntry;
+        }
+        while (result->NextRow());
+    }
+
+    for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+        if (Item* item = GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+            SetVisibleItemSlot(slot, item);
+}
