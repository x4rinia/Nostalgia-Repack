+bool HandleXUseHelper(Player* pTarget, GameObject* pGo)
+{
+    if (pTarget->AI())
+    {
+        if (dynamic_cast<PartyBotAI*>(pTarget->AI()))
+        {
+            if (pTarget->IsWithinDist(pGo, INTERACTION_DISTANCE))
+            {
+                pGo->Use(pTarget);
+                return true;
+            }
+        }
+    }
+
+    return false;
+}
