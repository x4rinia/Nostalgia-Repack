+bool PlayerBotMgr::CanSpawnOutdoorRivalFor(Player const* target, std::string* reason) const
+{
+    auto reject = [reason](char const* text)
+    {
+        if (reason)
+            *reason = text;
+        return false;
+    };
+
+    if (!target)
+        return reject("kein Spieler");
+    if (!target->IsInWorld())
+        return reject("nicht in der Welt");
+    if (!target->IsAlive())
+        return reject("tot");
+    if (target->IsGameMaster())
+        return reject("GM-Charakter");
+    if (target->IsTaxiFlying())
+        return reject("auf Flugroute");
+    if (target->IsInCombat())
+        return reject("im Kampf");
+    if (target->InBattleGround())
+        return reject("im Schlachtfeld");
+    if (target->GetLevel() < m_confOutdoorRivalsMinLevel)
+        return reject("Stufe zu niedrig");
+
+    Map const* map = target->GetMap();
+    if (!map || !map->IsContinent() || target->GetTransport())
+        return reject("keine passende Aussenwelt");
+
+    // Inns, capitals, towns and arenas are deliberately excluded from surprise encounters.
+    if (target->HasFlag(PLAYER_FLAGS, PLAYER_FLAGS_RESTING))
+        return reject("sicherer Ruhebereich");
+
+    if (AreaEntry const* area = AreaEntry::GetById(target->GetAreaId()))
+        if (area->Flags & (AREA_FLAG_CAPITAL | AREA_FLAG_CITY | AREA_FLAG_ARENA))
+            return reject("Stadt oder Arena");
+
+    return true;
+}
+
+bool PlayerBotMgr::IsOutdoorRivalEnemyTerritory(Player const* target) const
+{
+    if (!target)
+        return false;
+
+    AreaEntry const* zone = AreaEntry::GetById(target->GetZoneId());
+    if (!zone)
+        return false;
+
+    return (zone->Team == AREATEAM_ALLY && target->GetTeam() == HORDE) ||
+           (zone->Team == AREATEAM_HORDE && target->GetTeam() == ALLIANCE);
+}
+
+uint32 PlayerBotMgr::GetOutdoorRivalChanceFor(Player const* target) const
+{
+    return IsOutdoorRivalEnemyTerritory(target) ? m_confOutdoorRivalsEnemyChance : m_confOutdoorRivalsChance;
+}
+
+void PlayerBotMgr::NotifyOutdoorRivalDebug(std::string const& message) const
+{
+    if (!m_confOutdoorRivalsDebug)
+        return;
+
+    sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Rival-Debug] %s", message.c_str());
+    for (auto const& itr : sWorld.GetAllSessions())
+    {
+        WorldSession* session = itr.second;
+        Player* player = session ? session->GetPlayer() : nullptr;
+        if (player && player->IsGameMaster())
+            ChatHandler(player).PSendSysMessage("|cff4dc3ff[Rival-Debug]|r %s", message.c_str());
+    }
+}
+
+bool PlayerBotMgr::HasOutdoorRivalFor(ObjectGuid targetGuid) const
+{
+    for (auto const& itr : m_bots)
+        if (BattleBotAI const* battleBot = dynamic_cast<BattleBotAI const*>(itr.second->ai.get()))
+            if (battleBot->IsOutdoorRivalFor(targetGuid))
+                return true;
+
+    return false;
+}
+
+uint32 PlayerBotMgr::GetOutdoorRivalCount() const
+{
+    uint32 count = 0;
+    for (auto const& itr : m_bots)
+        if (BattleBotAI const* battleBot = dynamic_cast<BattleBotAI const*>(itr.second->ai.get()))
+            if (battleBot->IsOutdoorRival() && !itr.second->requestRemoval)
+                ++count;
+
+    return count;
+}
+
+bool PlayerBotMgr::AddOutdoorRival(Player* target, bool force)
+{
+    if (!target || (!force && !CanSpawnOutdoorRivalFor(target)) || HasOutdoorRivalFor(target->GetObjectGuid()) ||
+        (!force && GetOutdoorRivalCount() >= m_confOutdoorRivalsMaxActive))
+        return false;
+
+    Map const* map = target->GetMap();
+    if (!map || !map->IsContinent() || target->GetTransport())
+        return false;
+
+    Team const botTeam = target->GetTeam() == ALLIANCE ? HORDE : ALLIANCE;
+    std::vector<uint32> availableClasses = { CLASS_WARRIOR, CLASS_HUNTER, CLASS_ROGUE, CLASS_MAGE, CLASS_WARLOCK, CLASS_PRIEST, CLASS_DRUID };
+    if (botTeam == HORDE)
+        availableClasses.push_back(CLASS_SHAMAN);
+    else
+        availableClasses.push_back(CLASS_PALADIN);
+
+    uint8 const botClass = SelectRandomContainerElement(availableClasses);
+    uint8 const botRace = SelectRandomRaceForClass(botClass, botTeam);
+    if (!botRace)
+        return false;
+
+    float x, y, z;
+    target->GetNearPoint(target, x, y, z, 0.0f, frand(28.0f, 38.0f), frand(0.0f, 2.0f * M_PI_F));
+    BattleBotAI* ai = new BattleBotAI(botRace, botClass, target->GetLevel(), target->GetMapId(), target->GetMap()->GetInstanceId(),
+        x, y, z, target->GetOrientation(), BATTLEGROUND_QUEUE_NONE, true, true, target->GetObjectGuid(), m_confOutdoorRivalsDurationSeconds);
+
+    if (!AddBot(ai))
+    {
+        delete ai;
+        return false;
+    }
+
+    ChatHandler(target).SendSysMessage("|cff4dc3ff[Nostalgia]|r Ein feindlicher Rivale ist in der Naehe!");
+    std::ostringstream spawnMessage;
+    spawnMessage << "Rivale fuer " << target->GetName() << " (Stufe " << target->GetLevel() << ", "
+        << (IsOutdoorRivalEnemyTerritory(target) ? "feindliches Gebiet" : "neutrales/eigenes Gebiet") << ") erstellt.";
+    sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Nostalgia] %s", spawnMessage.str().c_str());
+    NotifyOutdoorRivalDebug(spawnMessage.str());
+    return true;
+}
+
+bool PlayerBotMgr::IsInGurubashiArena(Player const* player) const
+{
+    // These are the actual coordinates of the arena floor / chest, not the
+    // upper spectator ring.  Keeping this independent from the chest event
+    // makes permanent arena rivals work at every time of day.
+    static float const ARENA_CENTER_X = -13202.90f;
+    static float const ARENA_CENTER_Y = 276.76f;
+    static float const ARENA_RADIUS = 70.0f;
+
+    return player && player->IsInWorld() && player->GetMapId() == 0 &&
+        player->GetDistance2d(ARENA_CENTER_X, ARENA_CENTER_Y) <= ARENA_RADIUS;
+}
+
+bool PlayerBotMgr::StartRivalTest(Player* target)
+{
+    if (!target || !target->IsInWorld() || m_rivalTestSpawnTime || m_gurubashiArenaTestExpiry)
+        return false;
+
+    m_rivalTestTargetGuid = target->GetObjectGuid();
+    m_rivalTestArena = IsInGurubashiArena(target);
+    m_rivalTestSpawnTime = sWorld.GetGameTime() + 10;
+    m_rivalTestLastCountdown = 0;
+
+    sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Rival-Test] Test fuer %s gestartet: Rivalen erscheinen in 10 Sekunden (%s).",
+        target->GetName(), m_rivalTestArena ? "Gurubashi-Arena" : "Open World");
+    return true;
+}
+
+void PlayerBotMgr::CancelRivalTest()
+{
+    m_rivalTestSpawnTime = 0;
+    m_rivalTestLastCountdown = 0;
+    m_gurubashiArenaTestExpiry = 0;
+    m_rivalTestTargetGuid.Clear();
+    m_rivalTestArena = false;
+}
+
+void PlayerBotMgr::UpdateRivalTest()
+{
+    time_t const now = sWorld.GetGameTime();
+
+    if (m_gurubashiArenaTestExpiry && now >= m_gurubashiArenaTestExpiry)
+    {
+        m_gurubashiArenaTestExpiry = 0;
+        sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Rival-Test] Gurubashi-Arena-Test beendet.");
+    }
+
+    if (!m_rivalTestSpawnTime)
+        return;
+
+    if (now < m_rivalTestSpawnTime)
+    {
+        uint32 const remaining = uint32(m_rivalTestSpawnTime - now);
+        if (m_rivalTestLastCountdown != now)
+        {
+            m_rivalTestLastCountdown = now;
+            sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Rival-Test] Rivalen erscheinen in %u Sekunden.", remaining);
+        }
+        return;
+    }
+
+    Player* target = ObjectAccessor::FindPlayer(m_rivalTestTargetGuid);
+    bool const arenaTest = m_rivalTestArena && IsInGurubashiArena(target);
+    m_rivalTestSpawnTime = 0;
+    m_rivalTestLastCountdown = 0;
+    m_rivalTestTargetGuid.Clear();
+    m_rivalTestArena = false;
+
+    if (!target)
+    {
+        sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Rival-Test] Abgebrochen: GM ist nicht mehr online.");
+        return;
+    }
+
+    if (arenaTest)
+    {
+        if (!m_gurubashiArenaChestKnown)
+        {
+            // A GM test can run between chest events. Use the GM's floor
+            // position as the temporary center until the real chest appears.
+            m_gurubashiArenaChestKnown = true;
+            m_gurubashiArenaChestX = target->GetPositionX();
+            m_gurubashiArenaChestY = target->GetPositionY();
+            m_gurubashiArenaChestZ = target->GetPositionZ();
+        }
+
+        bool hasArenaRivals = false;
+        for (auto const& itr : m_bots)
+            if (BattleBotAI const* battleBot = dynamic_cast<BattleBotAI const*>(itr.second->ai.get()))
+                if (battleBot->IsGurubashiArenaRival() && !itr.second->requestRemoval)
+                    hasArenaRivals = true;
+
+        if (!hasArenaRivals)
+            AddGurubashiArenaRivals(3);
+        m_gurubashiArenaRivalTargetCount = 3;
+        m_gurubashiArenaNextRotation = now + HOUR;
+        m_gurubashiArenaTestExpiry = now + 120;
+        sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Rival-Test] Drei Arena-Rivalen fuer 120 Sekunden bereitgestellt.");
+        return;
+    }
+
+    if (AddOutdoorRival(target, true))
+        sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Rival-Test] Open-World-Rivale fuer %s erstellt.", target->GetName());
+    else
+        sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Rival-Test] Open-World-Rivale konnte nicht erstellt werden.");
+}
+
+void PlayerBotMgr::UpdateOutdoorRivals()
+{
+    if (!m_confOutdoorRivalsEnable || (!m_confOutdoorRivalsChance && !m_confOutdoorRivalsEnemyChance))
+        return;
+
+    time_t const now = sWorld.GetGameTime();
+    if (m_lastOutdoorRivalCheck && now < m_lastOutdoorRivalCheck + m_confOutdoorRivalsCheckSeconds)
+        return;
+    m_lastOutdoorRivalCheck = now;
+
+    {
+        std::ostringstream message;
+        message << "Pruefung gestartet: " << GetOutdoorRivalCount() << "/" << m_confOutdoorRivalsMaxActive << " Rivalen aktiv.";
+        NotifyOutdoorRivalDebug(message.str());
+    }
+
+    for (auto const& itr : sWorld.GetAllSessions())
+    {
+        if (GetOutdoorRivalCount() >= m_confOutdoorRivalsMaxActive)
+        {
+            NotifyOutdoorRivalDebug("Pruefung beendet: maximales Rivalen-Limit erreicht.");
+            return;
+        }
+
+        WorldSession* session = itr.second;
+        if (!session || session->GetBot())
+            continue;
+
+        Player* target = session->GetPlayer();
+        std::string reason;
+        if (!CanSpawnOutdoorRivalFor(target, &reason))
+        {
+            if (target)
+                NotifyOutdoorRivalDebug(std::string(target->GetName()) + " uebersprungen: " + reason + ".");
+            continue;
+        }
+
+        if (HasOutdoorRivalFor(target->GetObjectGuid()))
+        {
+            NotifyOutdoorRivalDebug(std::string(target->GetName()) + " uebersprungen: hat bereits einen Rivalen.");
+            continue;
+        }
+
+        auto cooldown = m_outdoorRivalCooldowns.find(target->GetObjectGuid());
+        if (cooldown != m_outdoorRivalCooldowns.end() && now < cooldown->second)
+        {
+            std::ostringstream message;
+            message << target->GetName() << " uebersprungen: Abklingzeit noch " << (cooldown->second - now) << " Sekunden.";
+            NotifyOutdoorRivalDebug(message.str());
+            continue;
+        }
+
+        uint32 const chance = GetOutdoorRivalChanceFor(target);
+        uint32 const roll = urand(1, 100);
+        if (roll > chance)
+        {
+            std::ostringstream message;
+            message << target->GetName() << ": Wurf " << roll << "/100 gegen " << chance << "% ("
+                << (IsOutdoorRivalEnemyTerritory(target) ? "feindliches Gebiet" : "neutrales/eigenes Gebiet") << ").";
+            NotifyOutdoorRivalDebug(message.str());
+            continue;
+        }
+
+        if (AddOutdoorRival(target))
+            m_outdoorRivalCooldowns[target->GetObjectGuid()] = now + m_confOutdoorRivalsCooldownSeconds;
+    }
+}
+
+void PlayerBotMgr::AddGurubashiArenaRivals(uint32 count)
+{
+    // Permanent rivals are intentionally independent from the timed chest.
+    // This is the centre of Gurubashi's combat floor, at the same height as the chest.
+    static float const ARENA_CENTER_X = -13202.90f;
+    static float const ARENA_CENTER_Y = 276.76f;
+    static float const ARENA_FLOOR_Z = 21.86f;
+    std::vector<uint32> availableClasses = { CLASS_WARRIOR, CLASS_HUNTER, CLASS_ROGUE, CLASS_MAGE, CLASS_WARLOCK, CLASS_PRIEST, CLASS_DRUID };
+    uint32 const instanceId = sMapMgr.GetContinentInstanceId(0, ARENA_CENTER_X, ARENA_CENTER_Y);
+    uint8 const arenaRivalLevel = uint8(sWorld.getConfig(CONFIG_UINT32_MAX_PLAYER_LEVEL));
+
+    for (uint32 i = 0; i < count && !availableClasses.empty(); ++i)
+    {
+        uint32 const classIndex = urand(0, availableClasses.size() - 1);
+        uint8 const botClass = uint8(availableClasses[classIndex]);
+        availableClasses.erase(availableClasses.begin() + classIndex);
+
+        Team const botTeam = urand(0, 1) ? HORDE : ALLIANCE;
+        uint8 const botRace = SelectRandomRaceForClass(botClass, botTeam);
+        if (!botRace)
+            continue;
+
+        float const angle = frand(0.0f, 2.0f * M_PI_F);
+        float const radius = frand(14.0f, 45.0f);
+        float const x = ARENA_CENTER_X + cos(angle) * radius;
+        float const y = ARENA_CENTER_Y + sin(angle) * radius;
+        BattleBotAI* ai = new BattleBotAI(botRace, botClass, arenaRivalLevel, 0, instanceId, x, y, ARENA_FLOOR_Z, angle + M_PI_F,
+            BATTLEGROUND_QUEUE_NONE, true, false, ObjectGuid(), 0, true);
+        if (!AddBot(ai))
+            delete ai;
+    }
+
+    sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Nostalgia] Gurubashi Arena: %u permanent rivals added.", count);
+}
+
+void PlayerBotMgr::DeleteGurubashiArenaRivals()
+{
+    for (auto const& itr : m_bots)
+        if (BattleBotAI* battleBot = dynamic_cast<BattleBotAI*>(itr.second->ai.get()))
+            if (battleBot->IsGurubashiArenaRival())
+            {
+                // Stop combat immediately. The regular bot-removal pass logs the player out
+                // on the following manager tick.
+                if (battleBot->me)
+                {
+                    battleBot->me->AttackStop(true);
+                    battleBot->me->CombatStop(true);
+                    battleBot->me->GetMotionMaster()->Clear();
+                }
+                itr.second->requestRemoval = true;
+            }
+}
+
+void PlayerBotMgr::OnGurubashiArenaChestSpawned(GameObject const* chest)
+{
+    if (!chest)
+        return;
+
+    m_gurubashiArenaChestKnown = true;
+    m_gurubashiArenaChestRemoved = false;
+    m_gurubashiArenaChestX = chest->GetPositionX();
+    m_gurubashiArenaChestY = chest->GetPositionY();
+    m_gurubashiArenaChestZ = chest->GetPositionZ();
+    sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Nostalgia] Gurubashi chest position: %.2f, %.2f, %.2f.",
+        m_gurubashiArenaChestX, m_gurubashiArenaChestY, m_gurubashiArenaChestZ);
+}
+
+void PlayerBotMgr::OnGurubashiArenaChestOpened(Player* player)
+{
+    static uint16 const GURUBASHI_ARENA_CHEST_EVENT = 16;
+
+    if (!player || !sGameEventMgr.IsActiveEvent(GURUBASHI_ARENA_CHEST_EVENT))
+        return;
+
+    player->SetFFAPvP(true);
+    uint32 attackers = 0;
+    for (auto const& itr : m_bots)
+    {
+        BattleBotAI* battleBot = dynamic_cast<BattleBotAI*>(itr.second->ai.get());
+        if (!battleBot || !battleBot->IsGurubashiArenaRival())
+            continue;
+
+        battleBot->SetGurubashiArenaTarget(player->GetObjectGuid());
+        if (!battleBot->me || !battleBot->me->IsInWorld() || battleBot->me->IsDead())
+            continue;
+
+        if (battleBot->me->GetMap() != player->GetMap())
+            continue;
+
+        battleBot->me->SetFFAPvP(true);
+        if (battleBot->AttackStart(player))
+            ++attackers;
+    }
+
+    sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "[Nostalgia] Gurubashi chest opened by %s: %u arena rivals engaging.", player->GetName(), attackers);
+}
