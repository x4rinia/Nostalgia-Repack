+                return source->Class == ITEM_CLASS_ARMOR && target->Class == ITEM_CLASS_ARMOR && source->InventoryType == INVTYPE_HANDS && target->InventoryType == INVTYPE_HANDS;
+            case TRANSMOG_ACTION_CLOAK:
+                return source->Class == ITEM_CLASS_ARMOR && target->Class == ITEM_CLASS_ARMOR && source->InventoryType == INVTYPE_CLOAK && target->InventoryType == INVTYPE_CLOAK;
+            case TRANSMOG_ACTION_FEET:
+                return source->Class == ITEM_CLASS_ARMOR && target->Class == ITEM_CLASS_ARMOR && source->InventoryType == INVTYPE_FEET && target->InventoryType == INVTYPE_FEET;
+            case TRANSMOG_ACTION_WEAPON_MAINHAND:
+            case TRANSMOG_ACTION_WEAPON_OFFHAND:
+                return IsOneHandedWeapon(source) && IsOneHandedWeapon(target);
+            case TRANSMOG_ACTION_SHIELD_OFFHAND:
+                return source->Class == ITEM_CLASS_ARMOR && target->Class == ITEM_CLASS_ARMOR &&
+                       source->InventoryType == INVTYPE_SHIELD && target->InventoryType == INVTYPE_SHIELD &&
+                       (source->SubClass == ITEM_SUBCLASS_ARMOR_SHIELD || source->SubClass == ITEM_SUBCLASS_ARMOR_BUCKLER);
+            case TRANSMOG_ACTION_WEAPON_TWOHAND:
+                return source->Class == ITEM_CLASS_WEAPON && target->Class == ITEM_CLASS_WEAPON &&
+                       source->InventoryType == INVTYPE_2HWEAPON && target->InventoryType == INVTYPE_2HWEAPON;
+            default:
+                return false;
+        }
+    }
+
+    bool IsTransmogSourceUsableBy(Player* player, ItemPrototype const* source)
+    {
+        return source && (source->AllowableClass & player->GetClassMask()) != 0 && (source->AllowableRace & player->GetRaceMask()) != 0;
+    }
+
+    bool GetTransmogItems(Player* player, uint32 action, Item*& source, Item*& target)
+    {
+        uint8 equipmentSlot = GetTransmogSlotFromAction(action);
+        source = player->GetItemByPos(INVENTORY_SLOT_BAG_0, INVENTORY_SLOT_ITEM_START);
+        target = player->GetItemByPos(INVENTORY_SLOT_BAG_0, equipmentSlot);
+
+        if (!source)
+        {
+            player->GetSession()->SendNotification("Lege die Optik-Vorlage in den ersten Platz deines Rucksacks.");
+            return false;
+        }
+
+        if (!target)
+        {
+            player->GetSession()->SendNotification("Du hast auf dem Platz %s kein Item angelegt.", GetTransmogSlotName(equipmentSlot));
+            return false;
+        }
+
+        if (!IsTransmogSourceUsableBy(player, source->GetProto()))
+        {
+            player->GetSession()->SendNotification("Diese Vorlage ist nicht fuer deine Klasse oder Rasse geeignet.");
+            return false;
+        }
+
+        if (!IsTransmogSlotCompatible(action, source->GetProto(), target->GetProto()))
+        {
+            player->GetSession()->SendNotification("Die Vorlage muss denselben Ausruestungsplatz und denselben Ruestungs- oder Waffentyp haben.");
+            return false;
+        }
+
+        return true;
+    }
+
+    void SendTransmogConfirmation(Player* player, Creature* creature, uint32 action)
+    {
+        Item* source = nullptr;
+        Item* target = nullptr;
+        if (!GetTransmogItems(player, action, source, target))
+        {
+            player->CLOSE_GOSSIP_MENU();
+            return;
+        }
+
+        std::string confirm = "Ja, " + std::string(target->GetProto()->Name1) + " wie " + source->GetProto()->Name1 + " aussehen lassen";
+        player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, confirm.c_str(), GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_CONFIRM_APPLY + (action - TRANSMOG_ACTION_HEAD));
+        player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Nein, zurueck", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_CANCEL);
+        player->SEND_GOSSIP_MENU(DEFAULT_GOSSIP_MESSAGE, creature->GetGUID());
+    }
+}
+
+bool GossipHello_Transmogger(Player* player, Creature* creature)
+{
+    player->GetSession()->SendNotification("Hinweis: Lege die Optik-Vorlage in Rucksackplatz 1, damit sie erkannt wird.");
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Kopf", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_HEAD);
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Schulter", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_SHOULDERS);
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Brust", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_CHEST);
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Beine", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_LEGS);
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Handschuhe", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_HANDS);
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Umhang", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_CLOAK);
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Stiefel", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_FEET);
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "1H-Waffe (Haupthand)", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_WEAPON_MAINHAND);
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "1H-Waffe (Nebenhand)", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_WEAPON_OFFHAND);
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Schildhand", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_SHIELD_OFFHAND);
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "2H-Waffe / Stab", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_WEAPON_TWOHAND);
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Transmog von allen Teilen entfernen", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_REMOVE_ALL);
+    player->SEND_GOSSIP_MENU(DEFAULT_GOSSIP_MESSAGE, creature->GetGUID());
+    return true;
+}
+
+bool GossipSelect_Transmogger(Player* player, Creature* creature, uint32 sender, uint32 action)
+{
+    if (sender != GOSSIP_SENDER_MAIN)
+        return true;
+
+    uint8 equipmentSlot = GetTransmogSlotFromAction(action);
+    if (equipmentSlot != NULL_SLOT)
+    {
+        SendTransmogConfirmation(player, creature, action);
+        return true;
+    }
+
+    if (action >= TRANSMOG_ACTION_CONFIRM_APPLY && action < TRANSMOG_ACTION_CONFIRM_REMOVE)
+    {
+        uint32 transmogAction = TRANSMOG_ACTION_HEAD + (action - TRANSMOG_ACTION_CONFIRM_APPLY);
+        equipmentSlot = GetTransmogSlotFromAction(transmogAction);
+        if (equipmentSlot == NULL_SLOT)
+        {
+            player->CLOSE_GOSSIP_MENU();
+            return true;
+        }
+        Item* source = nullptr;
+        Item* target = nullptr;
+        if (GetTransmogItems(player, transmogAction, source, target))
+        {
+            player->SetTransmogAppearance(target, source->GetEntry());
+            player->GetSession()->SendNotification("Die Optik von %s wurde auf %s uebertragen. Die Vorlage bleibt in deinem Rucksack.", source->GetProto()->Name1, target->GetProto()->Name1);
+        }
+        player->CLOSE_GOSSIP_MENU();
+        return true;
+    }
+
+    if (action == TRANSMOG_ACTION_REMOVE_ALL)
+    {
+        player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Ja, alle Transmog-Optiken entfernen", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_CONFIRM_REMOVE);
+        player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "Nein, zurueck", GOSSIP_SENDER_MAIN, TRANSMOG_ACTION_CANCEL);
+        player->SEND_GOSSIP_MENU(DEFAULT_GOSSIP_MESSAGE, creature->GetGUID());
+        return true;
+    }
+
+    if (action == TRANSMOG_ACTION_CONFIRM_REMOVE)
+    {
+        uint32 removed = 0;
+        for (uint8 equipmentSlot : TRANSMOG_SLOTS)
+            if (player->RemoveTransmogAppearance(equipmentSlot))
+                ++removed;
+
+        if (removed)
+            player->GetSession()->SendNotification("%u Transmog-Optik(en) entfernt.", removed);
+        else
+            player->GetSession()->SendNotification("Es gab keine Transmog-Optiken zum Entfernen.");
+    }
+
+    player->CLOSE_GOSSIP_MENU();
+    return true;
+}
